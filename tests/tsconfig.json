{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "typeRoots": ["../apps/web/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["../apps/web/node_modules/vite/client.d.ts", "integration/**/*.ts", "e2e/**/*.ts", "live/**/*.ts", "perf/**/*.ts", "render/**/*.ts", "support/**/*.ts", "fixtures/**/*.ts"]
}
