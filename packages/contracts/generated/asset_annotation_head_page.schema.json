{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssetAnnotationHeadPage",
  "type": "object",
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AssetAnnotationHead"
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AnnotationHeadSummary": {
      "type": "object",
      "required": [
        "annotation_revision_id",
        "approved_review_id",
        "completion",
        "content_hash",
        "object_count",
        "ontology_version_id",
        "revision_no"
      ],
      "properties": {
        "annotation_revision_id": {
          "$ref": "#/definitions/Id"
        },
        "approved_review_id": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "completion": {
          "$ref": "#/definitions/Completion"
        },
        "content_hash": {
          "type": "string"
        },
        "object_count": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        },
        "ontology_version_id": {
          "$ref": "#/definitions/Id"
        },
        "revision_no": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "AssetAnnotationHead": {
      "type": "object",
      "required": [
        "head",
        "media"
      ],
      "properties": {
        "head": {
          "anyOf": [
            {
              "$ref": "#/definitions/AnnotationHeadSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "$ref": "#/definitions/MediaRevision"
        }
      },
      "additionalProperties": false
    },
    "Completion": {
      "type": "string",
      "enum": [
        "unprocessed",
        "in_progress",
        "complete",
        "confirmed_negative"
      ]
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "MediaRevision": {
      "type": "object",
      "required": [
        "asset_id",
        "asset_revision_id",
        "canonical_height",
        "canonical_sha256",
        "canonical_width",
        "exif_orientation",
        "original_name",
        "original_sha256",
        "original_to_canonical",
        "project_id",
        "source_group_id"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/definitions/Id"
        },
        "asset_revision_id": {
          "$ref": "#/definitions/Id"
        },
        "canonical_height": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295.0,
          "minimum": 1.0
        },
        "canonical_sha256": {
          "type": "string"
        },
        "canonical_width": {
          "type": "integer",
          "format": "uint32",
          "maximum": 4294967295.0,
          "minimum": 1.0
        },
        "exif_orientation": {
          "type": "integer",
          "format": "uint8",
          "maximum": 8.0,
          "minimum": 1.0
        },
        "original_name": {
          "type": "string"
        },
        "original_sha256": {
          "type": "string"
        },
        "original_to_canonical": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 9,
          "minItems": 9
        },
        "project_id": {
          "$ref": "#/definitions/Id"
        },
        "source_group_id": {
          "$ref": "#/definitions/Id"
        }
      },
      "additionalProperties": false
    }
  }
}
