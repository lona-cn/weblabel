{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApiError",
  "type": "object",
  "required": [
    "code",
    "details",
    "message",
    "request_id"
  ],
  "properties": {
    "code": {
      "type": "string"
    },
    "details": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "request_id": {
      "$ref": "#/definitions/Id"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    }
  }
}
