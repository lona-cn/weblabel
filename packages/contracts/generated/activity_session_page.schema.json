{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActivitySessionPage",
  "type": "object",
  "required": [
    "items",
    "next_cursor"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ActivitySession"
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "$ref": "#/definitions/Id"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ActivityInterval": {
      "type": "object",
      "required": [
        "duration_ms",
        "kind",
        "seq"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "maximum": 86400000.0,
          "minimum": 1.0
        },
        "kind": {
          "$ref": "#/definitions/ActivityKind"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ActivityKind": {
      "type": "string",
      "enum": [
        "task",
        "annotation",
        "correction",
        "review",
        "switch",
        "model_wait"
      ]
    },
    "ActivitySession": {
      "type": "object",
      "required": [
        "intervals",
        "session_id",
        "version"
      ],
      "properties": {
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ActivityInterval"
          }
        },
        "session_id": {
          "$ref": "#/definitions/Id"
        },
        "version": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    }
  }
}
