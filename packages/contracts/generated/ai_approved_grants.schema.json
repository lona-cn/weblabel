{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AiApprovedGrants",
  "type": "object",
  "required": [
    "allow_image",
    "allow_object_context",
    "preview_crop"
  ],
  "properties": {
    "allow_image": {
      "type": "boolean"
    },
    "allow_object_context": {
      "type": "boolean"
    },
    "preview_crop": {
      "description": "Explicit null approves the full image; omission must never broaden scope.",
      "anyOf": [
        {
          "$ref": "#/definitions/BBox"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "BBox": {
      "type": "object",
      "required": [
        "type",
        "x_max",
        "x_min",
        "y_max",
        "y_min"
      ],
      "properties": {
        "type": {
          "$ref": "#/definitions/BBoxType"
        },
        "x_max": {
          "type": "number",
          "format": "double"
        },
        "x_min": {
          "type": "number",
          "format": "double"
        },
        "y_max": {
          "type": "number",
          "format": "double"
        },
        "y_min": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "BBoxType": {
      "type": "string",
      "enum": [
        "bbox_xyxy"
      ]
    }
  }
}
