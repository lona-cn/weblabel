{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectMember",
  "type": "object",
  "required": [
    "role",
    "user_id",
    "username"
  ],
  "properties": {
    "role": {
      "$ref": "#/definitions/ProjectMemberRole"
    },
    "user_id": {
      "$ref": "#/definitions/Id"
    },
    "username": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "ProjectMemberRole": {
      "type": "string",
      "enum": [
        "admin",
        "annotator",
        "reviewer",
        "viewer"
      ]
    }
  }
}
