+                                [
+                                    (b[0] - viewport.tx) / scale,
+                                    (b[1] - viewport.ty) / scale,
+                                    (b[2] - viewport.tx) / scale,
+                                    (b[3] - viewport.ty) / scale,
+                                ],
+                            )
