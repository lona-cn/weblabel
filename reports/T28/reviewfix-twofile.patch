+                        [100.0 + gap_css, 20.0, 110.0, 30.0],
+                        [20.0, -10.0, 30.0, -gap_css],
+                        [20.0, 100.0 + gap_css, 30.0, 110.0],
+                    ];
+                    let objects: Vec<_> = css_boxes
