# Registration snippet (no production entry constructs a ProviderRegistry yet —
# same situation T18/T20/T22 reported; wire this when the host entry exists,
# keep `mock: false`):
#
#   import { createClaudeLocalAdapter } from './providers/claude/adapter';
#   import { createStdioClaudeTransport } from './providers/claude/adapter';
#   registry.register('claude_local', createClaudeLocalAdapter({
#     permissions: claudePermissionsConfig,   // private runRoot, forbiddenCwdRoots (user repos/workspace),
#                                             // envAllowlist (minimal; credential vars and NODE_OPTIONS are
#                                             // hard-denied), command/mcpCommand point at the official CLI
#                                             // and apps/agent-host/src/mcp/main.ts, model: null or the
#                                             // requested id/alias
#     transport: createStdioClaudeTransport,
#     imageSource: <consent-layer grant resolver>,
#     runToken: <run-scoped token issuer>,
#     schemaArtifactPath: <T32 pinned-runtime stream-json protocol fixture>,
