**/target/
node_modules/
.pnpm-store/
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
playwright-report/
test-results/
# Python detector service (services/detector, T18)
__pycache__/
.pytest_cache/
/services/detector/.venv/
*.egg-info/
# Owned disposable Chromium profiles and private runtime data.
/reports/T31/runs/*/runtime/
/reports/T31/pixels/*/runtime/

# Public history: generated auth-bearing evidence must stay local.
/reports/**
!/reports/**/
!/reports/**/*.mjs
!/reports/**/*.js
!/reports/**/*.ts
!/reports/**/*.mts
!/reports/**/*.py
!/reports/**/*.ps1
!/reports/**/*.rs
!/reports/index.md
!/reports/publication/**

# Disposable build output, model weights and workstation-local configuration.
/apps/web/dist/
/services/detector/weights/
/.omp/config.yml
# Never include raw browser network traces, even under source-code exceptions.
/reports/**/trace/
/reports/**/trace.zip
/reports/**/.last-run.json
# Historical copied worktrees and their generated caches are not release source.
/reports/**/cleanup-preservation/
# Committed historical helper sources remain eligible; outputs stay private.
!/reports/**/*.cjs
# Generated runtime/build caches never qualify as committed historical tools.
/reports/**/runtime/
/reports/**/vite-cache/
/reports/**/playwright-transform-cache/
/reports/**/node-compile-cache/
/reports/**/target/
